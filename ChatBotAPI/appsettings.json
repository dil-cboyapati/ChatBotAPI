{
	"Serilog": {
		"Using": [ "Serilog.Sinks.File" ],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft.AspNetCore": "Warning",
				"System": "Warning"
			}
		},
		"WriteTo": [
			{
				"Name": "Console"
			},
			{
				"Name": "File",
				"Args": {
					"path": "Logs/chatbot-.log",
					"rollingInterval": "Day",
					"outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
					"fileSizeLimitBytes": 10485760,
					"rollOnFileSizeLimit": true,
					"retainedFileCountLimit": 30
				}
			}
		],
		"Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
	},
	"AllowedHosts": "*",
	"OpenAI": {
		"Model": "gpt-3.5-turbo",
		"APIKey": "provide open ai API key"
	},
	"ClientsApplicationData": [
		{
			"ApplicationName": [ "QA", "QA APPLICATION", "QA APP" ],
			"DatabaseName": "coi3qa",
			"ConnectionString": "",
			"Environments": [ "DEV", "QA" ],
			"UnlockAccountKeywords": [ "unlock", "release" ],
			"ResetPasswordKeywords": [ "update", "change", "reset" ],
			"ForceChangePasswordKeywords": [ "" ]
		},
		{
			"ApplicationName": [ "SECURITY", "SECURITY APPLICATION", "SECURITY APP" ],
			"DatabaseName": "security2",
			"ConnectionString": "",
			"Environments": [ "DEV", "QA" ],
			"UnlockAccountKeywords": [ "unlock", "release" ],
			"ResetPasswordKeywords": [ "update", "change", "reset" ],
			"ForceChangePasswordKeywords": [ "" ]
		},
		{
			"ApplicationName": [ "UMMS", "UMMC", "NYP" ],
			"DatabaseName": "",
			"ConnectionString": "",
			"Environments": [ "Pre Production", "PreProd" ],
			"UnlockAccountKeywords": [ "unlock", "release" ],
			"ResetPasswordKeywords": [ "update", "change", "reset" ],
			"ForceChangePasswordKeywords": [ "" ]
		}
		],
	"SqsSettings": {
		"QueueUrl": "",
		"AwsRegion": "us-west-2",
		"AwsAccessKeyId": "",
		"AwsSecretAccessKey": "",
		"MaxNumberOfMessages": 10,
		"WaitTimeSeconds": 20,
		"PollingIntervalSeconds": 600
	},
	"BedrockSettings": {
		"ModelId": "anthropic.claude-3-5-sonnet-20241022-v2:0",
		"AwsRegion": "us-west-2",
		"AwsAccessKeyId": "",
		"AwsSecretAccessKey": "",
		"MaxTokens": 2000,
		"Temperature": 0.7,
		"TopP": 0.9
	}
}

